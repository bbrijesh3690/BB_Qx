{
  "name": "bb-qx",
  "version": "0.1.0",
  "private": true,
  "description": "Quorum (codename BB_Qx): shadow-mode next-candle evidence system for Quotex, as a Chrome MV3 extension",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:ext": "node scripts/build-extension.mjs",
    "harness": "tsx src/harness/cli.ts",
    "analyze-frames": "tsx scripts/analyze-frames.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "idb": "^8.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
